{
  "name": "split-the-bills-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run lint && npm run test && npm run test:deploy && npm run test:dev",
    "predeploy:firebase": "node scripts/check-node.mjs",
    "deploy:firebase": "node scripts/deploy.mjs",
    "preemulators": "node scripts/check-node.mjs && npm run build",
    "emulators": "node scripts/start-emulators.mjs",
    "seed:demo": "node scripts/check-node.mjs && node scripts/seed-demo.mjs",
    "test:dev": "node --test scripts/demo-data.test.mjs scripts/start-emulators.test.mjs",
    "test:seed": "node --test scripts/seed-demo.emulator.test.mjs",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run build && node --test lib/contracts.test.js lib/domain/calculations.test.js",
    "test:deploy": "node --test scripts/deploy.test.mjs",
    "test:rules": "npm run build && node --test lib/firestore.rules.test.js",
    "test:emulator": "node --test lib/backend/backend.emulator.test.js"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "24.3.1",
    "eslint": "10.10.0",
    "firebase": "12.18.0",
    "firebase-tools": "15.29.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
